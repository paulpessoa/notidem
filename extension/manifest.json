{
  "manifest_version": 3,
  "name": "Notidem — thoughtful replies for LinkedIn & X",
  "version": "2.0.0",
  "description": "The opposite of 'idem'. Draft genuine replies on LinkedIn and X in your own voice, with your context. Always reviewed by you.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.groq.com https://api.openai.com https://generativelanguage.googleapis.com https://api.anthropic.com https://www.google-analytics.com"
  },
  "host_permissions": [
    "https://api.groq.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": [
        "src/content/registry.js",
        "src/content/ui-styles.js",
        "src/content/platforms/linkedin.js",
        "src/content/core.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*", "https://mobile.twitter.com/*"],
      "js": [
        "src/content/registry.js",
        "src/content/ui-styles.js",
        "src/content/platforms/x.js",
        "src/content/core.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "Notidem",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    }
  },
  "options_page": "src/ui/options.html"
}
